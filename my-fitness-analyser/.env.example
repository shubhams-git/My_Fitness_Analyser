# Local Garmin app (never commit a real key)
API_KEY=

# Local cloud-mode switch. Hosted API routes always require private sign-in.
FITNESS_CLOUD_ENABLED=0
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bootstrap owner only: binds the existing server Garmin key, not user login.
FITNESS_OWNER_ID=
APP_ORIGIN=
GARMIN_PERSONAL_API_KEY=

# Gemini Free credentials are for the local synthetic lab and synthetic probes.
GEMINI_API_KEY=
# Optional server-side credential rotation. The entire app shares one rate limit.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_KEY_POOL_FREE_CONFIRMED=0
# Model override for the local synthetic review. Hosted coaching has its own route.
GEMINI_MODEL=gemini-3.6-flash
# Set to 1 only after checking that this key's project is on the Free plan.
GEMINI_FREE_TIER_CONFIRMED=0

# Hosted health evidence requires member opt-in and a provider project approved
# for these submissions. Leave disabled until the project and its terms are verified.
GEMINI_PERSONAL_DATA_APPROVED=0
GEMINI_PERSONAL_API_KEY=
GEMINI_PERSONAL_API_KEY_2=
GEMINI_PERSONAL_API_KEY_3=
GEMINI_PERSONAL_API_KEY_4=
GEMINI_PERSONAL_API_KEY_5=

# Optional MapTiler Cloud Free-plan browser key for sharper replay imagery.
# Restrict it to the deployed app origin in MapTiler. This key is sent to the browser.
MAPTILER_BROWSER_KEY=
