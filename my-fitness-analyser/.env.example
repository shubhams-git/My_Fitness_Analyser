# Local Garmin app (never commit a real key)
API_KEY=

# Local cloud-mode switch. Hosted API routes always require private sign-in.
FITNESS_CLOUD_ENABLED=0
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bootstrap owner only: binds the existing server Garmin key, not user login.
FITNESS_OWNER_ID=
APP_ORIGIN=
GARMIN_PERSONAL_API_KEY=

# Gemini is server-only. Hosted personal reviews require each member's opt-in.
GEMINI_API_KEY=
# Hosted rotation requires at least two distinct keys from confirmed Free projects.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_KEY_POOL_FREE_CONFIRMED=0
# Model override for the local synthetic review. Hosted coaching has its own route.
GEMINI_MODEL=gemini-3.6-flash
# Set to 1 only after checking that this key's project is on the Free plan.
GEMINI_FREE_TIER_CONFIRMED=0
