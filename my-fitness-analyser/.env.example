# Local Garmin app (never commit a real key)
API_KEY=

# Local cloud-mode switch. Hosted API routes always require private sign-in.
FITNESS_CLOUD_ENABLED=0
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bootstrap owner only: binds the existing server Garmin key, not user login.
FITNESS_OWNER_ID=
APP_ORIGIN=
GARMIN_PERSONAL_API_KEY=

# Hosted analysis rotates five distinct server-side keys from an eligible Gemini project.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Local synthetic tools only.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FREE_TIER_CONFIRMED=0

# Optional MapTiler Cloud Free-plan browser key for sharper replay imagery.
# Restrict it to the deployed app origin in MapTiler. This key is sent to the browser.
MAPTILER_BROWSER_KEY=
